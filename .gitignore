__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
.DS_Store

# local caches of bridged/derived geometry and downloaded transforms
cache/
data/cache/

# Ingested assets are rebuildable from source; caches are fetched, not shipped.
registry/data/*.npz
# Sidecar arrays for legacy npz volumes too large to compress (tens of GB).
registry/data/*.npy
# OME-Zarr stores are directories, and are rebuildable like everything here.
registry/data/*.zarr/
registry/data/.stainwork/
